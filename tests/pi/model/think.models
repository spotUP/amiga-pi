      "low": "lo",
      "xhigh": "xh"
     }
    },
    {
     "id": "reason-nooff",
     "reasoning": true,
     "thinkingLevelMap": {
      "off": null
     }
    },
    {
     "id": "reason-onlymax",
     "reasoning": true,
     "thinkingLevelMap": {
      "minimal": null,
      "low": null,
      "medium": null,
      "high": null,
      "max": "max"
     }
    }
   ]
  }
 }
}
