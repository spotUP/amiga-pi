    }
   ]
  },
  {
   "role": "assistant",
   "content": [
    {
     "type": "tool_use",
     "id": "toolu_1",
     "name": "greet",
     "input": {
      "name": "Ada"
     }
    }
   ]
  },
  {
   "role": "user",
   "content": [
    {
     "type": "tool_result",
