   },
   {
    "text": "/review src",
    "out": "Review src focusing on quality. All: src"
   },
   {
    "text": "/review src \"a b\" 'c d'",
    "out": "Review src focusing on a b. All: src a b c d"
   },
   {
    "text": "/plain\n\nx",
