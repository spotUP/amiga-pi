 "expand": {
  "templates": [
   {
    "name": "review",
    "content": "Review $1 focusing on ${2:-quality}. All: $@"
   },
   {
    "name": "plain",
    "content": "plain body\n"
   },
   {
    "name": "ns:sub",
    "content": "[$ARGUMENTS]"
   },
   {
    "name": "dup",
    "content": "first"
   },
   {
    "name": "dup",
    "content": "second"
   }
  ],
  "cases": [
   {
    "text": "/review src",
    "out": "Review src focusing on quality. All: src"
   },
   {
    "text": "/review",
    "out": "Review  focusing on quality. All: "
   },
   {
    "text": "/review src  tests\nmore",
    "out": "Review src focusing on tests. All: src tests more"
   },
   {
    "text": "/review   ",
    "out": "Review  focusing on quality. All: "
   },
   {
    "text": "/review\n",
    "out": "Review  focusing on quality. All: "
   },
   {
    "text": "/review\tsrc",
    "out": "Review src focusing on quality. All: src"
   },
   {
    "text": "/plain",
    "out": "plain body\n"
   },
   {
    "text": "/plain x y",
    "out": "plain body\n"
   },
   {
    "text": "/ns:sub a b",
    "out": "[a b]"
   },
   {
    "text": "/dup",
    "out": "first"
   },
   {
    "text": "/nosuch x",
    "out": "/nosuch x"
   },
   {
    "text": "/Review src",
    "out": "/Review src"
   },
   {
    "text": "review src",
    "out": "review src"
   },
   {
    "text": " /review src",
    "out": " /review src"
   },
   {
    "text": "/",
    "out": "/"
   },
   {
    "text": "//review",
